<!--
  Drobot Navigation Behavior Tree v3
  목표 방향 회전 → 경로 추종 → 막히면 복구
  - 내부 recovery: costmap 클리어 + backup만 (spin 제거 → replanner + RotationShim이 방향 처리)
  - 외부 recovery: costmap 클리어 + backup + 작은 spin (최후 수단)
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <!-- 메인 네비게이션 -->
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased"/>

        <!-- 경로 계획 -->
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}"/>
            <!-- 글로벌 costmap 을 지우지 않는다. 2026-10-05
                 여기 ClearEntireCostmap(global) 이 있었다. 계획이 실패할 때마다
                 학습한 장애물이 통째로 사라져, 아래 36 행 주석이 경고한 루프가
                 그대로 일어났다.
                 실측 (dumps/cm_atA.txt vs cm_atB.txt, 9 초 간격):
                   LETHAL  1001 -> 466,  금지(>=99) -> 자유 로 내려간 칸 1721
                   지워진 범위 x -0.30~6.15, y -0.25~11.25 (맵 전체)
                 raytrace_max_range 가 3.0 m 이므로 센서 clearing 으로는
                 설명되지 않는 범위다 — 통째 삭제였다.
                 그 결과 A 를 막힌 것으로 확인 -> 지워짐 -> B 로 계획 ->
                 B 도 막힘 -> 지워짐 -> 다시 A. 무한 진동.
                 대신 센서가 갱신될 시간만 주고 같은 계획을 재시도한다. -->
            <Sequence name="WaitAndReplan">
              <Wait wait_duration="1.0" name="WaitForSensors"/>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}"/>
            </Sequence>
          </RecoveryNode>
        </RateController>

        <!-- 경로 추종 (실패 시 클리어 + backup만, spin 없음) -->
        <RecoveryNode number_of_retries="3" name="FollowPathWithRecovery">
          <FollowPath path="{path}" controller_id="{selected_controller}"/>
          <Sequence name="BackupAndRetry">
            <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
            <BackUp backup_dist="0.3" backup_speed="0.15" name="BackUpSmall"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>

      <!-- 최후 복구: 로컬 클리어 → 후진 → 작은 회전 (45°)
           글로벌 costmap 은 일부러 지우지 않는다. 2026-10-04
           사전 맵이 없고 track_unknown_space:false 라 미탐색 영역은 자유 공간이다.
           로봇은 주행하면서 벽을 하나씩 '배워' 글로벌에 쌓는데, 여기서 글로벌을
           지우면 그 학습이 통째로 사라진다. 그러면 플래너가 다시 빈 벌판에
           직선을 긋고, 로봇은 같은 벽에 코를 박고, 또 실패하고, 또 지운다 —
           영원히 같은 실수를 반복한다 (실측: 플래너는 매번 성공하는데 로봇은
           벽 앞 0.25m 에서 멈춤).
           실제로 로봇을 빼내는 건 BackUp/Spin 이다. 기억은 남겨둔다.
           로컬은 매 주기 재생성되므로 지워도 안전하다. -->
      <!-- Sequence 가 아니라 RoundRobin 이다. 2026-10-04
           Sequence 였을 때는 BackUp 이 실패하면 그 뒤의 Spin 이 아예 실행되지
           않았다. 실측 로그:
             "Collision Ahead - Exiting DriveOnHeading" → "backup failed"
             → 곧바로 "Goal failed"  (Spin 로그 없음)
           전진이 막힌 상태에서 후진까지 거부당하면 로봇을 빼낼 수단이 사라져
           그 자리에 영구히 선다.
           RoundRobin 은 한 동작이 실패하면 다음 재시도에서 '다른' 동작을
           고르므로, 후진이 막혀도 회전/대기로 빠져나갈 기회가 남는다. -->
      <RoundRobin name="RecoveryActions">
        <Spin spin_dist="0.785" name="Spin45"/>
        <BackUp backup_dist="0.5" backup_speed="0.15" name="BackUp"/>
        <Sequence name="ClearAndSettle">
          <ClearEntireCostmap name="ClearLocalCostmap" service_name="local_costmap/clear_entirely_local_costmap"/>
          <Wait wait_duration="2.0" name="WaitForSensors"/>
        </Sequence>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
