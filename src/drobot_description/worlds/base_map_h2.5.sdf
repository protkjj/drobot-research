<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="base_map_h2.5">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <!-- ogre2 가 아니라 ogre(v1) 다. 바꾸지 말 것.
           RTX 5070 Ti(Blackwell, driver 580) + gz-sim 8.11 조합에서 ogre2 는
           렌더 스레드 초기화를 끝내지 못하고, Sensors 시스템이 그걸 기다리다
           시뮬 루프 전체가 멈춘다 (/clock 부터 모든 토픽이 0 이 된다).
           EGL 자체는 정상이다 (eglInitialize 성공, EGL 1.5, libEGL_nvidia 존재).
           headless 렌더링 플래그도 GUI 모드도 효과가 없었고, ogre v1 로 바꾸니
           센서 3개(gpu_lidar/rgbd/imu)가 모두 정상 동작했다. 2026-10-01 확인. -->
      <render_engine>ogre</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_0">
      <static>true</static>
      <pose>3.0 0.05 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.1 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.1 3.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.8 1</ambient>
            <diffuse>0.5 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="obstacle_1">
      <static>true</static>
      <pose>3.0 10.95 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.1 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.1 3.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.8 1</ambient>
            <diffuse>0.5 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="obstacle_2">
      <static>true</static>
      <pose>0.05 5.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 11.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 11.0 3.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.8 1</ambient>
            <diffuse>0.5 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="obstacle_3">
      <static>true</static>
      <pose>5.95 5.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 11.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 11.0 3.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.8 1</ambient>
            <diffuse>0.5 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="obstacle_4">
      <static>true</static>
      <pose>2.0 5.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 3.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 3.0 2.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.8 1</ambient>
            <diffuse>0.5 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="start_marker">
      <static>true</static>
      <pose>2.0 1.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.0 1.0 0.0 1.0</ambient>
            <diffuse>0.0 1.0 0.0 1.0</diffuse>
            <emissive>0.0 0.3 0.0 1</emissive>
          </material>
          <transparency>0.2</transparency>
        </visual>
      </link>
    </model>
    <model name="goal_marker">
      <static>true</static>
      <pose>2.0 10.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.85 0.0 1.0</ambient>
            <diffuse>1.0 0.85 0.0 1.0</diffuse>
            <emissive>0.3 0.255 0.0 1</emissive>
          </material>
          <transparency>0.2</transparency>
        </visual>
      </link>
    </model>
  </world>
</sdf>
